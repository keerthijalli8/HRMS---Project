# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_TIMEZONE=Asia/Kolkata

# Security & Encryption
# 32-byte hex key for AES-256-GCM encryption of stored face embeddings
ENCRYPTION_KEY=a7d2f8319e04bc581e2894b6138d9f10a8b417e290f6c24387d091e325a7b8e1
JWT_SECRET=hrms_super_secure_jwt_secret_token_2026_key
JWT_EXPIRES_IN=15m

# Face Recognition & Anti-Spoofing Settings
# Strict Cosine Distance threshold for SFace 128-d (<= 0.48 => Cosine Similarity >= 0.52)
FACE_MATCH_THRESHOLD=0.48
ANTISPOOF_THRESHOLD=0.72
FACE_MIN_BRIGHTNESS=35
FACE_MAX_BRIGHTNESS=235
FACE_MIN_SHARPNESS=22

# Anti-Replay & Lockout Policies
CHALLENGE_TTL_SECONDS=45
OTP_TTL_SECONDS=180
MAX_FACE_LOGIN_ATTEMPTS=5
DPDP_CONSENT_VERSION=2026.1-DPDP-IN
PHOTO_RETENTION_DAYS=90

# Database
DB_TYPE=sqlite
DB_PATH=./backend/data/hrms_face.sqlite
